# Base URL of the Spring Boot backend (business-review-backend), no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional — enables a real static map image on business profile pages
# (spec §17b). Without it, a lightweight placeholder pin graphic is shown
# instead; "Get directions" still works either way via the Google Maps
# deep link, which needs no API key.
NEXT_PUBLIC_GOOGLE_STATIC_MAPS_KEY=
